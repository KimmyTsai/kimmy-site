---
import { localePath, formatDate, isoDate, splitId, type Locale } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  locale: Locale;
  showSummary?: boolean;
}
const { posts, locale, showSummary = true } = Astro.props;
---

<ul class="post-list" data-probe-label="post index">
  {
    posts.map((p) => {
      const { slug } = splitId(p.id);
      return (
        <li>
          <a href={localePath(locale, `/blog/${slug}`)}>
            <time class="post-date" datetime={isoDate(p.data.pubDate)}>
              {formatDate(p.data.pubDate, locale)}
            </time>
            <span>
              <span class="post-title">{p.data.title}</span>
              {showSummary && <span class="post-summary">{p.data.summary}</span>}
            </span>
            {p.data.tags.length > 0 && (
              <ul class="tags">
                {p.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </a>
        </li>
      );
    })
  }
</ul>
