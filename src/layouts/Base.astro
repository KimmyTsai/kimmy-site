---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, useTranslations, LOCALES, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pathKey: string;
  ogType?: string;
  availableIn?: readonly Locale[];
}

const {
  title,
  description,
  locale,
  pathKey,
  ogType = 'website',
  availableIn = LOCALES,
} = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <BaseHead
      title={title}
      description={description}
      locale={locale}
      pathKey={pathKey}
      ogType={ogType}
      availableIn={availableIn}
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header locale={locale} pathKey={pathKey} availableIn={availableIn} />
    <main id="main" data-copy={t('action.copy')} data-copied={t('action.copied')}>
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // ------------------------------------------------------------------
      // 前端小互動。全部都是漸進增強：沒有 JS 網站照樣可讀。
      // ------------------------------------------------------------------
      const root = document.documentElement;

      function setupTheme() {
        const btn = document.getElementById('theme-toggle');
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });
      }

      // 彩蛋一：探針模式 —— 幫版面上的區塊標註，像看規格書的元件標號
      function setupProbe() {
        const btn = document.getElementById('probe-toggle');
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const on = root.dataset.probe === 'on';
          if (on) delete root.dataset.probe;
          else root.dataset.probe = 'on';
          btn.setAttribute('aria-pressed', String(!on));
        });
      }

      // 彩蛋二：Konami code → CRT 磷光模式
      const KONAMI = [
        'ArrowUp','ArrowUp','ArrowDown','ArrowDown',
        'ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a',
      ];
      let idx = 0;
      function onKey(e: KeyboardEvent) {
        const want = KONAMI[idx];
        if (e.key.toLowerCase() === want.toLowerCase()) {
          idx++;
          if (idx === KONAMI.length) {
            idx = 0;
            const on = root.dataset.crt === 'on';
            if (on) {
              delete root.dataset.crt;
              try { localStorage.removeItem('crt'); } catch {}
            } else {
              root.dataset.crt = 'on';
              try { localStorage.setItem('crt', 'on'); } catch {}
            }
          }
        } else {
          idx = e.key === KONAMI[0] ? 1 : 0;
        }
      }

      // 程式碼區塊：補上語言標籤與複製鈕。
      // Shiki 產出的是 <pre class="astro-code" data-language="…">，
      // 這裡把它包一層好定位；pre 本身有 overflow-x，按鈕放進去會被捲走。
      function setupCodeBlocks() {
        const labels = document.getElementById('main')?.dataset ?? {};
        const copy = labels.copy ?? 'Copy';
        const copied = labels.copied ?? 'Copied';

        document.querySelectorAll('.prose pre.astro-code').forEach((pre) => {
          const el = pre as HTMLElement;
          if (el.parentElement?.classList.contains('code-block')) return;

          const wrap = document.createElement('div');
          wrap.className = 'code-block';
          el.parentNode?.insertBefore(wrap, el);
          wrap.appendChild(el);

          const bar = document.createElement('div');
          bar.className = 'code-bar';

          const lang = el.dataset.language;
          if (lang && lang !== 'plaintext') {
            const tag = document.createElement('span');
            tag.className = 'code-lang';
            tag.textContent = lang;
            bar.appendChild(tag);
          }

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.textContent = copy;
          btn.addEventListener('click', async () => {
            const text = el.querySelector('code')?.textContent ?? el.textContent ?? '';
            try {
              await navigator.clipboard.writeText(text);
              btn.textContent = copied;
              btn.classList.add('is-done');
              setTimeout(() => {
                btn.textContent = copy;
                btn.classList.remove('is-done');
              }, 1600);
            } catch {
              // 沒有剪貼簿權限（非 HTTPS 之類）就安靜略過，內容仍可自行選取
            }
          });
          bar.appendChild(btn);
          wrap.insertBefore(bar, el);
        });
      }

      function boot() {
        setupTheme();
        setupProbe();
        setupCodeBlocks();
      }

      document.addEventListener('keydown', onKey);
      document.addEventListener('astro:page-load', boot);
      boot();

      console.log(
        '%c  ┌───────────────┐\n  │ ▪ ▪ ▪ ▪ ▪ ▪ ▪ │   KIMMY · CSIE\n  │  hi there ✦   │   RISC-V / FPGA / PQC\n  │ ▪ ▪ ▪ ▪ ▪ ▪ ▪ │   src: github\n  └───────────────┘',
        'font-family:monospace;color:#c9752f;line-height:1.5',
      );
    </script>
  </body>
</html>
