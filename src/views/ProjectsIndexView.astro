---
import Base from '../layouts/Base.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { pageTitle } from '../lib/profile';
import { useTranslations, type Locale } from '../i18n/ui';
import { getProjects } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects(locale);
---

<Base
  title={pageTitle(locale, t('projects.title'))}
  description={t('projects.description')}
  locale={locale}
  pathKey="/projects"
>
  <div class="wrap">
    <header class="page-head">
      <h1>{t('projects.title')}</h1>
      <p class="lede">{t('projects.description')}</p>
    </header>

    {
      projects.length ? (
        <ProjectCards projects={projects} locale={locale} />
      ) : (
        <p class="empty">{t('projects.empty')}</p>
      )
    }
  </div>
</Base>
